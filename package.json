    "@types/shelljs": "^0.8.11",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "chalk": "^5.3.0",
    "coveralls": "^3.1.1",
    "cypress": "^15.10.0",
    "cypress-hmr-restarter": "^2.0.4",
